{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EcoInsumos FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "console": "integratedTerminal"
        }
    ]
}
